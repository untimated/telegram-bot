# Configuration checklist for the Telegram <-> DeepSeek bot.
#
# NOTHING READS THIS FILE AUTOMATICALLY. Go does not load .env files, and Cloud
# Run does not either. It exists so you can see at a glance which settings the
# bot understands. Real values belong in one of two places:
#
#   Cloud Run (production):
#     gcloud functions deploy TelegramHook --gen2 ... \
#       --set-env-vars=ALLOWED_CHAT_IDS=-1001234567890,DEEPSEEK_MODEL=deepseek-flash \
#       --set-secrets=TELEGRAM_BOT_TOKEN=telegram-bot-token:latest,DEEPSEEK_API_KEY=deepseek-api-key:latest
#
#   Your shell (local runs):
#     set -a; . ./.env; set +a
#
# Copy to .env to keep real values locally; .env is git-ignored, this file is not.

# --- Telegram ----------------------------------------------------------------

# Required. The bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional but recommended. If set, Telegram must send this exact value in the
# X-Telegram-Bot-Api-Secret-Token header, otherwise the bot answers 401.
# It must match the secret_token you pass to setWebhook:
#   curl -s "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://YOUR-FUNCTION-URL" -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_WEBHOOK_SECRET=

# Optional. Comma-separated list of chat ids the bot will answer.
# Leave empty to answer everywhere. A group id is negative, e.g. -1001234567890.
# Handy for a friends-only bot: set this to your group so a stranger who finds
# the bot's @username in a direct message cannot spend your DeepSeek credit.
# Tip: put a wrong id here first and the logs will print the real id it ignored.
ALLOWED_CHAT_IDS=

# --- DeepSeek ----------------------------------------------------------------

# Required. From https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# deepseek-flash (fast and ~10x cheaper) or deepseek-v4-pro (stronger).
DEEPSEEK_MODEL=deepseek-flash

# none = answer straight away. low | high | max make the model think first,
# which is slower and costs more output tokens.
DEEPSEEK_REASONING_EFFORT=none

# Optional. Replaces the built-in assistant prompt.
# SYSTEM_PROMPT=You are a helpful assistant in a Telegram group of friends. Keep replies short.

# --- Endpoints ---------------------------------------------------------------
# Defaults are the real services. Only change these to route through a proxy,
# or to point at a fake server in tests.

# TELEGRAM_API_BASE=https://api.telegram.org
# DEEPSEEK_BASE_URL=https://api.deepseek.com
